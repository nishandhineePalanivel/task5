      <!-- 6. REGISTRATION FORM & LIVE PREVIEW SECTION (TASK 4 PRESERVED + TASK 5 API INTEGRATED) -->
      <section id="register" class="py-5 bg-light">
        <div class="container py-4">
          <div class="row justify-content-center mb-4">
            <div class="col-lg-10 text-center">
              <div class="d-inline-flex align-items-center justify-content-center w-12 h-12 rounded-circle bg-primary-light text-primary mb-3">
                <i class="bi bi-shield-check fs-3"></i>
              </div>
              <h2 class="h3 font-heading fw-bold mb-1">Student Registration Application</h2>
              <p class="text-muted small mb-0">Level 3 - Task 5: Validated Inputs Submitted to REST API (`POST /api/registrations`)</p>
            </div>
          </div>

          <div class="row g-4">
            <!-- Registration Form Column -->
            <div class="col-lg-7">
              <div class="registration-card h-100">
                <h3 class="h5 font-heading fw-bold mb-3 d-flex align-items-center gap-2">
                  <i class="bi bi-pencil-square text-primary"></i> Application Form
                </h3>

                <form id="registration-form" action="/submit" method="POST" class="needs-validation" novalidate>
                  
                  <!-- Full Name Input -->
                  <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <label for="name" class="form-label mb-0">Full Name <span class="text-danger">*</span></label>
                      <small id="name-char-count" class="text-muted font-mono" style="font-size: 0.75rem;">0 / 50 characters</small>
                    </div>
                    <div class="input-group">
                      <span class="input-group-text bg-light"><i class="bi bi-person text-muted"></i></span>
                      <input 
                        type="text" 
                        class="form-control" 
                        id="name" 
                        name="name" 
                        placeholder="e.g. John Doe"
                        maxlength="50"
                        required
                      >
                    </div>
                    <div id="name-error" class="invalid-feedback"></div>
                  </div>

                  <!-- Email Address Input -->
                  <div class="mb-3">
                    <label for="email" class="form-label">Email Address <span class="text-danger">*</span></label>
                    <div class="input-group">
                      <span class="input-group-text bg-light"><i class="bi bi-envelope text-muted"></i></span>
                      <input 
                        type="email" 
                        class="form-control" 
                        id="email" 
                        name="email" 
                        placeholder="e.g. john@college.edu" 
                        required
                      >
                    </div>
                    <div id="email-error" class="invalid-feedback"></div>
                  </div>

                  <!-- Phone Number & Age Row -->
                  <div class="row g-3 mb-3">
                    <div class="col-md-7">
                      <label for="phone" class="form-label">Phone Number (10-Digit) <span class="text-danger">*</span></label>
                      <div class="input-group">
                        <span class="input-group-text bg-light">+91</span>
                        <input 
                          type="tel" 
                          class="form-control" 
                          id="phone" 
                          name="phone" 
                          placeholder="e.g. 9876543210"
                          maxlength="10" 
                          required
                        >
                      </div>
                      <div id="phone-error" class="invalid-feedback"></div>
                    </div>

                    <div class="col-md-5">
                      <label for="age" class="form-label">Age <span class="text-danger">*</span></label>
                      <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-calendar text-muted"></i></span>
                        <input 
                          type="number" 
                          class="form-control" 
                          id="age" 
                          name="age" 
                          placeholder="e.g. 20" 
                          min="16" 
                          max="100"
                          required
                        >
                      </div>
                      <div id="age-error" class="invalid-feedback"></div>
                    </div>
                  </div>

                  <!-- Course Selection -->
                  <div class="mb-3">
                    <label for="course" class="form-label">Desired Engineering Course <span class="text-danger">*</span></label>
                    <div class="input-group">
                      <span class="input-group-text bg-light"><i class="bi bi-journal-bookmark text-muted"></i></span>
                      <select class="form-select" id="course" name="course" required>
                        <option value="" disabled selected>-- Select Engineering Course --</option>
                        <option value="B.E. Electronics and Communication Engineering">B.E. Electronics and Communication Engineering</option>
                        <option value="B.E. Computer Science and Engineering">B.E. Computer Science and Engineering</option>
                        <option value="B.Tech Information Technology">B.Tech Information Technology</option>
                        <option value="B.E. Mechanical Engineering">B.E. Mechanical Engineering</option>
                        <option value="B.E. Electrical and Electronics Engineering">B.E. Electrical and Electronics Engineering</option>
                      </select>
                    </div>
                    <div id="course-error" class="invalid-feedback"></div>
                  </div>

                  <!-- Password Input & Show/Hide Toggle -->
                  <div class="mb-3">
                    <label for="password" class="form-label">Password <span class="text-danger">*</span></label>
                    <div class="input-group">
                      <span class="input-group-text bg-light"><i class="bi bi-lock text-muted"></i></span>
                      <input 
                        type="password" 
                        class="form-control" 
                        id="password" 
                        name="password" 
                        placeholder="Create secure password" 
                        required
                      >
                      <button class="btn btn-outline-secondary" type="button" id="toggle-password" aria-label="Show Password">
                        <i class="bi bi-eye-fill"></i>
                      </button>
                    </div>
                    <div id="password-error" class="invalid-feedback"></div>

                    <!-- Dynamic Password Strength Progress Bar & Badge -->
                    <div class="mt-2 p-2.5 bg-light rounded border">
                      <div class="d-flex justify-content-between align-items-center mb-1.5 small">
                        <span class="fw-bold text-muted" style="font-size: 0.8rem;">Password Strength:</span>
                        <span id="password-strength-text" class="badge bg-secondary">None</span>
                      </div>
                      <div class="progress" style="height: 6px;">
                        <div id="password-strength-bar" class="progress-bar bg-secondary" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                      </div>
                    </div>

                    <!-- Dynamic Password Requirement Checklist -->
                    <div class="mt-2 p-2.5 bg-white rounded border small">
                      <div class="fw-bold text-muted mb-1" style="font-size: 0.75rem;">Password Requirements Checklist:</div>
                      <ul class="list-unstyled mb-0 font-mono" style="font-size: 0.75rem;">
                        <li id="req-length" class="text-muted d-flex align-items-center gap-1.5 py-0.5"><i class="bi bi-circle text-muted"></i> Minimum 8 characters</li>
                        <li id="req-uppercase" class="text-muted d-flex align-items-center gap-1.5 py-0.5"><i class="bi bi-circle text-muted"></i> At least one uppercase letter (A-Z)</li>
                        <li id="req-lowercase" class="text-muted d-flex align-items-center gap-1.5 py-0.5"><i class="bi bi-circle text-muted"></i> At least one lowercase letter (a-z)</li>
                        <li id="req-number" class="text-muted d-flex align-items-center gap-1.5 py-0.5"><i class="bi bi-circle text-muted"></i> At least one number (0-9)</li>
                        <li id="req-special" class="text-muted d-flex align-items-center gap-1.5 py-0.5"><i class="bi bi-circle text-muted"></i> At least one special character (!@#$%^&*)</li>
                      </ul>
                    </div>
                  </div>

                  <!-- Confirm Password Input & Show/Hide Toggle -->
                  <div class="mb-3">
                    <label for="confirmPassword" class="form-label">Confirm Password <span class="text-danger">*</span></label>
                    <div class="input-group">
                      <span class="input-group-text bg-light"><i class="bi bi-lock-fill text-muted"></i></span>
                      <input 
                        type="password" 
                        class="form-control" 
                        id="confirmPassword" 
                        name="confirmPassword" 
                        placeholder="Re-enter password to match" 
                        required
                      >
                      <button class="btn btn-outline-secondary" type="button" id="toggle-confirm-password" aria-label="Show Password">
                        <i class="bi bi-eye-fill"></i>
                      </button>
                    </div>
                    <div id="confirmPassword-error" class="invalid-feedback"></div>
                  </div>

                  <!-- Terms and Conditions Checkbox -->
                  <div class="mb-4 form-check">
